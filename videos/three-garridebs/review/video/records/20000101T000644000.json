  "notes": [
    {
      "id": "fb-g0qgChGk",
      "time": 24.8,
      "shotId": "02",
      "address": "video:shot.02",
      "x": 0.362,
      "y": 0.571,
      "text": "ワトスンの後ろに立ち止まるのは03と接続しないので、変。普通に椅子に03みたいな恰好になるように座ってほしい",
      "displayedVariants": {
        "video:shot.02.motion": "v-KYK0YiXq",
        "animatic:shot.02#narrationStem": "v-muirlTTF"
      }
    },
    {
      "id": "fb-pgFM93To",
      "time": 75,
      "shotId": "10",
      "address": "video:shot.10",
      "x": 0.203,
      "y": 0.67,
      "text": "最初のフレームでは、中腰で座っている",
      "displayedVariants": {
        "video:shot.10.motion": "v-duqcLcPt"
      }
    }
  ],
  "handoffId": "20000101T000633000",
  "handoffSummary": "1幕のいただいたご指摘6本を作り直しました。残り11本は採用済みです。",
  "handoffNotes": [
    {
      "address": "video:shot.01",
      "text": "光は署名の上に留まったまま動かず、舞う埃だけが動くようにしました。"
    },
    {
      "address": "video:shot.02",
      "text": "戸口で一度立ち止まってから、赤い肘掛け椅子へ歩いていきます。"
    },
    {
      "address": "video:shot.06",
      "text": "光の明るさを最初のフレームのまま一定に保つよう書き直しました。暗くならないかご確認ください。"
    },
    {
      "address": "video:shot.10",
      "text": "立って電話帳を持った姿から、腰をかがめて差し出す形にしました。"
    },
    {
      "address": "video:shot.12",
      "text": "始まりは二人が横顔で向き合っていて、そこからドアの方へ振り向きます。"
    },
    {
      "address": "video:shot.14",
      "text": "足音で動きを止め、目を上げてドアの方へ顔を向けて耳を澄まし、笑みが消えます。"
    }
  ]
}