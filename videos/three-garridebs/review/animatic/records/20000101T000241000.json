  "notes": [
    {
      "id": "fb-5yEtly15",
      "time": 37.43333333333333,
      "shotId": "04",
      "address": "animatic:shot.04",
      "text": "発音変わらないな「カネ」とか「鐘」とかにしてみて。",
      "displayedVariants": {
        "animatic:shot.04.key": "v-VJqDJl55",
        "animatic:shot.04.watson": "v-nCg84lsL",
        "animatic:shot.04.holmes": "v-a9ETghla"
      }
    },
    {
      "id": "fb-RKQ8WD8y",
      "time": 79,
      "shotId": "11",
      "address": "animatic:shot.11",
      "text": "発音変わらないな。「サシダシニン」で撮ってみて。",
      "displayedVariants": {
        "animatic:shot.11.key": "v-6yKFVsEp",
        "animatic:shot.11.holmes": "v-iXYif15U"
      }
    },
    {
      "id": "fb-2EDtczrX",
      "time": 25,
      "shotId": "03",
      "address": "animatic:shot.03",
      "x": 0.081,
      "y": 0.853,
      "text": "この plate のショット、ここの赤い椅子が写ってるのがよくない。ワトスンが座っているのに座っていない",
      "displayedVariants": {
        "animatic:shot.03.key": "v-u7693C4x",
        "animatic:shot.03.holmes": "v-9AKnf6ZM",
        "animatic:shot.03#composition": "v-lgUzo2dI"
      }
    },
    {
      "id": "fb-Ty4ebNrl",
      "time": 12,
      "shotId": "02",
      "address": "animatic:shot.02",
      "x": 0.199,
      "y": 0.68,
      "text": "椅子に背もたれがない。",
      "displayedVariants": {
        "animatic:shot.02.key": "v-EOZnEKpb",
        "animatic:shot.02.narration": "v-yXpZPrOc",
