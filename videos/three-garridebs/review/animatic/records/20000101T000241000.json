  ],
  "handoffId": "20000101T000240000",
  "handoffSummary": "残り5ショットを直しました。04・08・11の声は、別テイクを複数用意しています。聞き比べて、良いテイクを選んでください。",
  "handoffNotes": [
    {
      "address": "animatic:shot.04",
      "text": "「かね」の発音違いで3テイク録り直しました。"
    },
    {
      "address": "animatic:shot.08",
      "text": "07の絵を手がかりに、同じ画角・机・光のまま手だけが動く絵に描き直しました。語りも数テイク録り直しています。"
    },
    {
      "address": "animatic:shot.11",
      "text": "「さしだしにん」の発音違いで3テイク録り直しました。"
    },
    {
      "address": "animatic:shot.14",
      "text": "台詞のあとから階段の足音を鳴らし始め、15へ途切れずにつなげました。足音は一歩ずつはっきり聞こえる重い靴音に作り直しています。"
    },
    {
      "address": "animatic:shot.15",
      "text": "14から続く足音を頭に置き、聞き取りやすく音量を上げました。"
    }
  ]
}